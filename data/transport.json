  "cards":[
    {"name":"Fiziksel ICOCA — ana öneri","buy":"Kişi başı bir kart. JR Kansai-airport gişesi/ICOCA logolu JR-West makineleri. 2.000 JPY örneği: 500 depozito + 1.500 kullanılabilir bakiye.","pay":"Fiziksel kart satın alma ve standart makinede yükleme için nakit yen hazırla. İlk gün karta ilave 2.000–3.000 JPY yüklemek önerilen başlangıç payıdır.","use":"Osaka, Kyoto, Nara ve Tokyo'da uyumlu IC işaretli tren/metro/otobüs ve bazı dükkânlarda. Ayrı Suica/PASMO almak zorunlu değil.","limits":"İndirimli sınırsız bilet değildir. Her yolcu kendi kartını kullanır. Shinkansen ve rezervasyonlu otobüs ayrıca bilet ister. Bakiye üst sınırı 20.000 JPY. Tokyo'da JR-West kart iadesi yapılabileceğini varsayma; bakiye şişirme.","sources":["icoca","topup","icuse"]},
    {"name":"Uyumlu iPhone varsa dijital IC alternatifi","buy":"Apple Pay ICOCA/Suica veya Welcome Suica Mobile, cihaz ve banka uyumuna göre alternatif. Fiziksel kart en az kurulum gerektiren plan.","pay":"Dijital cüzdanda desteklenen kartla yükleme mümkün olabilir; Türk kartının çalışacağı garantisi yok. Nakit/fiziksel kart yedeği tut.","use":"Aynı seyahatte telefon kartı veya fiziksel karttan birini ana kart seç; girişte hangisini kullandıysan çıkışta da onu kullan.","limits":"Telefon modeli bilinmiyor. Yabancı Android'de NFC olması tek başına Japon mobil IC desteği demek değil. Welcome Suica'nın Samsung sürümü 2027 ilk yarı için duyuruldu; Kasım 2037 planına eklenmedi.","sources":["icuse","iphone"]},
    {"name":"Kredi kartıyla turnike — yedek seçenek","buy":"Osaka Metro'da desteklenen temassız banka/kredi kartı kullanılabilir; okuyucusu farklı olabilir.","pay":"Giriş ve çıkışta aynı fiziksel kart veya aynı cihaz. Fiziksel kartla girip telefonla çıkma.","use":"Osaka Metro resmi sayfası Visa/Mastercard dahil desteklenen markaları listeliyor. Diğer işletmecilerin kabulü ayrıca kontrol edilir.","limits":"Tüm Japon trenleri kredi kartını turnikede kabul ediyor varsayımı yapılmadı. Bu yüzden ortak ana çözüm ICOCA.","sources":["tap"]},
    {"name":"JR Pass / günlük pass","buy":"Bu plana genel JR Pass varsayılan olarak eklenmedi: tek yön Osaka–Tokyo var; Kyoto/Nara'da özel demiryolları kullanılıyor.","pay":"Önce tekil bilet toplamıyla karşılaştır. JR Pass'in 7 günlük normal yetişkin resmî çevrim içi fiyat referansı 50.000 JPY.","use":"Osaka ve Tokyo günlük pass'leri ancak o gün kapsanan hatlarda yeterince yolculuk varsa düşünülür.","limits":"Tokyo Subway Ticket, JR Yamanote/Chuo ve Tokyo Monorail yerine geçmez. Bu rotada ICOCA + tek Shinkansen bileti daha uygun başlangıç varsayımıdır; bu bir hesaplanmış en ucuz garanti değildir.","sources":["pass","metro","jr","monorail"]}
  ],
  "payments":[
    {"where":"Tren/metro normal yolculuk","method":"ICOCA","detail":"Turnikede aynı kartla giriş/çıkış. Bakiye yetmezse yükleme. Kyoto Randen'de son inişte ödeme; Katabiranotsuji aktarmasında ayrıca ödeme yapma.","sources":["icuse","randen"]},
    {"where":"ICOCA yükleme","method":"Nakit JPY","detail":"Fiziksel kartı standart tren makinelerinde kredi kartıyla yükleyebileceğini varsayma. Yanında küçük banknot bulundur.","sources":["topup"]},
    {"where":"Shinkansen 17 Kasım","method":"Ayrı bilet; resmî rezervasyonda uygun kredi kartı","detail":"SmartEX ile IC kart eşleştirilebilir; bu, Shinkansen ücretinin ICOCA bakiyesinden ödendiği anlamına gelmez. QR/kâğıt bilet alternatifi var. Henüz rezervasyon yok.","sources":["smartEx"]},
    {"where":"Gotemba rezervasyonlu otobüs","method":"Ayrı rezervasyon ve bilet","detail":"ICOCA'ya güvenip binme. Seçilen işletmecinin çevrim içi ödeme ve dönüş seferi şartına göre bilet al; şu an alınmış bilet yok.","sources":["gotemba"]},
    {"where":"Hands / Cocokarafine / büyük mağaza","method":"Kredi kartı; mağazaya göre IC de var","detail":"Bu iki şubenin resmî sayfası kart/ulaşım IC ödeme seçeneklerini listeliyor. Diğer mağazada kabul ve kampanya fiyatını kasada sor.","sources":["hands","coco"]},
    {"where":"Bit pazarı, küçük yiyecek dükkânı, tapınak","method":"Nakit yen hazırlığı","detail":"Tüm satıcılarda kart kabulü doğrulanmadı. Kişi başı başlangıçta 10.000–20.000 JPY erişilebilir nakit payı benim planlama önerim; sabit zorunlu tutar değil.","sources":["atm"]},
    {"where":"ATM / kur seçimi","method":"Seven Bank gibi yabancı kart kabul eden ATM","detail":"Kart markası ve banka işlem izni gerekir. Nakit çekim ücreti/kredi kartı nakit avans bedeli bankana bağlıdır. Ödeme para birimi ve dönüşüm masrafını onay ekranında kontrol et.","sources":["atm"]},
    {"where":"Çok valizle Shinkansen","method":"Bilette uygun bagaj yeri seçimi","detail":"Uçaktaki 100 kg hak trende aynı hak değildir. JR kuralı kişi başı iki büyük bagaj, parça başına 30 kg veya az; üç kenar toplamı 250 cm veya az. 160 cm'yi aşan büyük valiz için uygun bagaj alanlı koltuk rezervasyonu planla. Toplam yük fazlaysa otelden otele gönderim ayrıca araştırılmalı.","sources":["bag"]}
  ],
